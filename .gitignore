/data/
checkpoints/
# Logs: ignore everything except the structured result CSVs (jury-verifiable evidence).
# Excludes noisy/large files (experiment.log, TensorBoard events).
logs/*
!logs/*/
logs/*/*
!logs/*/cifar10c_results.csv
!logs/*/cifar10c_per_class.csv
!logs/*/metrics.csv
# Smoke-test runs are pipeline sanity checks, not scientific results — keep out of git.
logs/smoke-test/
__pycache__/
*.pyc
*.pyo
.DS_Store
wandb/
*.egg-info/
dist/
build/
.venv/
ignore/

# Reference paper PDFs — keep summaries (which include arXiv links), but do
# not bloat the repo with the binaries themselves. Each summary in
# docs/papers/summaries/ links to ../pdfs/<file>.pdf for local browsing;
# users can populate that folder by re-downloading from the arXiv links.
docs/papers/pdfs/

# LaTeX / Beamer build artifacts (presentation source is tracked, the
# rendered PDF is tracked, intermediates are not).
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz
*.fls
*.fdb_latexmk
*.xdv
*.bbl
*.blg
*.lof
*.lot
